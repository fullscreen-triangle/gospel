\contentsline {table}{\numberline {11.1}{\ignorespaces Partition depths $\mathcal {M}_X$ (base-$e$ units) corresponding to the GHK permeability ratios in the mammalian resting neuron. Partition depths are computed via $P_X = e^{-\mathcal {M}_X}$, normalised to $\mathcal {M}_K = 0$ for clarity.}}{153}{table.caption.15}%
\contentsline {table}{\numberline {11.2}{\ignorespaces Nernst potentials and partition depth differences for physiological ions at $T = 310$\,K. Concentrations are representative mammalian neuronal values. $\Delta \mathcal {M}_X$ is in base-$e$ units.}}{154}{table.caption.16}%
