\@writefile{toc}{\contentsline {paragraph}{Correlations (\Cref  {fig:dep}A).}{7}{section*.24}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Why they disagree (\Cref  {fig:dep}A, B).}{7}{section*.25}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Batch is a first-order component of noise, rescue is the least reliable construction, and replication should add runs.} (\textbf  {A})~Col-0 was grown in 13 usable blocks of 7 plants spread through the screen. Block means (bars) differ beyond plant noise ($F=3.76$, $p=1.7\times 10^{-4}$, ICC $=0.28$). The spread of the block means is 0.43 of the between-accession spread, and Col-0 alone moves from the 54th to the 92nd percentile of accessions. (\textbf  {B})~Shoot gain with 95\% intervals under the reference noise model (M3), sorted. Eighteen of 235 intervals include zero (red). Under plant noise alone (M2) six do. Per-1 is compatible with zero in shoot and root under every model. (\textbf  {C})~Reliability $\mathcal  R$ (\Cref  {def:het}) by construction and noise model. Adding batch noise lowers the reliability of rescue to 0.35 (shoot) and 0.48 (root); the other two constructions remain between 0.66 and 0.83. Heterogeneity is significant for every construction, organ and model (\Cref  {tab:het}). (\textbf  {D})~Reliability of the canonical construction as a function of independent runs $r$, for 7 and 28 plants per cell. Quadrupling the plants moves reliability by at most 0.05; a second run moves it by 0.15--0.17.}}{8}{figure.caption.16}\protected@file@percent }
\newlabel{fig:noise}{{2}{8}{\textbf {Batch is a first-order component of noise, rescue is the least reliable construction, and replication should add runs.} (\textbf {A})~Col-0 was grown in 13 usable blocks of 7 plants spread through the screen. Block means (bars) differ beyond plant noise ($F=3.76$, $p=1.7\times 10^{-4}$, ICC $=0.28$). The spread of the block means is 0.43 of the between-accession spread, and Col-0 alone moves from the 54th to the 92nd percentile of accessions. (\textbf {B})~Shoot gain with 95\% intervals under the reference noise model (M3), sorted. Eighteen of 235 intervals include zero (red). Under plant noise alone (M2) six do. Per-1 is compatible with zero in shoot and root under every model. (\textbf {C})~Reliability $\mathcal R$ (\Cref {def:het}) by construction and noise model. Adding batch noise lowers the reliability of rescue to 0.35 (shoot) and 0.48 (root); the other two constructions remain between 0.66 and 0.83. Heterogeneity is significant for every construction, organ and model (\Cref {tab:het}). (\textbf {D})~Reliability of the canonical construction as a function of independent runs $r$, for 7 and 28 plants per cell. Quadrupling the plants moves reliability by at most 0.05; a second run moves it by 0.15--0.17}{figure.caption.16}{}}
\newlabel{fig:noise@cref}{{[figure][2][]2}{[1][7][]8}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {The three constructions in use disagree about which accessions rescue best, and sometimes certify opposite orders.} (\textbf  {A})~Spearman correlations across 235 accessions (shoot) between the constructions and three nuisance quantities: size under inoculation $W$, vigour ${M_{\mathrm  N}}$, and mock-only drought loss. Percentage increase is nearly uncorrelated with size but correlates at 0.80 with drought loss. Gain correlates at 0.60 with size. Rescue is the least loaded on either. (\textbf  {B})~Rank by percentage increase against rank by rescue, coloured by drought loss. Accessions far above the diagonal are drought-sensitive: their small ${M_{\mathrm  D}}$ inflates the ratio. (\textbf  {C})~Fraction of the top 20\% (47 accessions) that changes between two constructions (bars), against the 95th percentile of the same fraction under resampling of one construction: plant noise (blue) and plant + batch noise (red). In root every pair exceeds even the batch-inclusive ceiling (0.57--0.70 against 0.36--0.40). (\textbf  {D})~Pairs of accessions certified in \emph  {opposite} order by two constructions (\Cref  {def:order}, $\delta =0.5$ SD). Under plant noise these number 63--433 in shoot and 174--700 in root. With batch noise they fall to 0--81.}}{9}{figure.caption.23}\protected@file@percent }
\newlabel{fig:dep}{{3}{9}{\textbf {The three constructions in use disagree about which accessions rescue best, and sometimes certify opposite orders.} (\textbf {A})~Spearman correlations across 235 accessions (shoot) between the constructions and three nuisance quantities: size under inoculation $\WD $, vigour $\MN $, and mock-only drought loss. Percentage increase is nearly uncorrelated with size but correlates at 0.80 with drought loss. Gain correlates at 0.60 with size. Rescue is the least loaded on either. (\textbf {B})~Rank by percentage increase against rank by rescue, coloured by drought loss. Accessions far above the diagonal are drought-sensitive: their small $\MD $ inflates the ratio. (\textbf {C})~Fraction of the top 20\% (47 accessions) that changes between two constructions (bars), against the 95th percentile of the same fraction under resampling of one construction: plant noise (blue) and plant + batch noise (red). In root every pair exceeds even the batch-inclusive ceiling (0.57--0.70 against 0.36--0.40). (\textbf {D})~Pairs of accessions certified in \emph {opposite} order by two constructions (\Cref {def:order}, $\delta =0.5$ SD). Under plant noise these number 63--433 in shoot and 174--700 in root. With batch noise they fall to 0--81}{figure.caption.23}{}}
\newlabel{fig:dep@cref}{{[figure][3][]3}{[1][7][]9}{}{}{}}
\@writefile{toc}{\contentsline {paragraph}{Top sets (\Cref  {fig:dep}C).}{10}{section*.26}\protected@file@percent }
